/////////////////////////////////////////////////////////////////////////////
// Korean (Korea) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_KOR)
LANGUAGE LANG_KOREAN, SUBLANG_DEFAULT

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_FONTEDITOR MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        POPUP "새로 만들기(&N)"
        BEGIN
            MENUITEM "일반 용도 (font) (&M)",           ID_FILE_NEW_MAINGAMEFONT
            MENUITEM "로비 전용 (font_lobby) (&L)",     ID_FILE_NEW_LOBBYFONT
            MENUITEM "한국어 (KrnAXIS) (&K)",          ID_FILE_NEW_KRNAXIS
            MENUITEM "간체 중국어 (ChnAXIS) (&C)",       ID_FILE_NEW_CHNAXIS
            MENUITEM "번체 중국어 (tcaxis) (&T)",        ID_FILE_NEW_TCAXIS
        END
        MENUITEM "열기(&O)\tCtrl+O",              ID_FILE_OPEN
        MENUITEM "저장하기(&S)\tCtrl+S",            ID_FILE_SAVE
        MENUITEM "다른 이름으로 저장하기(&A)\tCtrl+Shift+S", ID_FILE_SAVEAS
        MENUITEM "복사본 저장하기(&C)",                ID_FILE_SAVECOPYAS
        MENUITEM SEPARATOR
        POPUP "언어(&L)"
        BEGIN
            MENUITEM "자동(&A)",                      ID_FILE_LANGUAGE_AUTO
            MENUITEM SEPARATOR
            MENUITEM "영어 (English)(&E)",            ID_FILE_LANGUAGE_ENGLISH, CHECKED
            MENUITEM "한국어 (&K)",                    ID_FILE_LANGUAGE_KOREAN
            MENUITEM "중국어 (简体中文)(&C)",              ID_FILE_LANGUAGE_CHINESE
        END
        MENUITEM "게임 설치 경로 설정(&G)",             ID_FILE_GAMEINSTALLATIONMANAGER
        MENUITEM SEPARATOR
        MENUITEM "끝내기(&X)\tCtrl+Q",             ID_FILE_EXIT
    END
    POPUP "편집(&E)"
    BEGIN
        MENUITEM "추가(&A)\tIns",                 ID_EDIT_ADD
        MENUITEM "폰트로 요소 추가(&N)...\tShift+Ins",  ID_EDIT_ADDELEMENTFROMFONT
        MENUITEM "폰트에서 추가(&F)...",             ID_EDIT_ADDFROMFONT
        MENUITEM "자동 맞춤(&T)\tF",                ID_EDIT_AUTOFIT
        MENUITEM "모든 크기 자동 맞춤(&Z)\tShift+F",   ID_EDIT_AUTOFITALLSIZES
        MENUITEM "잘라내기(&C)\tCtrl+X",            ID_EDIT_CUT
        MENUITEM "복사(&C)\tCtrl+C",              ID_EDIT_COPY
        MENUITEM "붙여넣기(&P)\tCtrl+V",            ID_EDIT_PASTE
        MENUITEM "지우기(&D)\tDel",                ID_EDIT_DELETE
        MENUITEM "모두 선택(&S)\tCtrl+A",           ID_EDIT_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "자세히(&E)\tEnter",              ID_EDIT_DETAILS
        MENUITEM SEPARATOR
        MENUITEM "세로 위치 감소(위로)\tW",              ID_EDIT_DECREASEVERTICALOFFSET
        MENUITEM "세로 위치 증가(아래로)\tS",             ID_EDIT_INCREASEVERTICALOFFSET
        MENUITEM "가로 오프셋 감소(왼쪽으로)\tA",          ID_EDIT_DECREASEHORIZONTALOFFSET
        MENUITEM "가로 오프셋 증가(오른쪽으로)\tD",         ID_EDIT_INCREASEHORIZONTALOFFSET
        MENUITEM "자간 감소\tQ",                    ID_EDIT_DECREASELETTERSPACING
        MENUITEM "자간 증가\tE",                    ID_EDIT_INCREASELETTERSPACING
        MENUITEM "폰트 크기 감소 (-1px)\t[",          ID_EDIT_DECREASEFONTSIZEBY1
        MENUITEM "폰트 크기 증가 (+1px)\t]",          ID_EDIT_INCREASEFONTSIZEBY1
        MENUITEM "폰트 크기 감소 (-0.5px)\tShift+[",  ID_EDIT_DECREASEFONTSIZEBY0_2
        MENUITEM "폰트 크기 증가 (+0.5px)\tShift+]",  ID_EDIT_INCREASEFONTSIZEBY0_2
        MENUITEM "병합 방법 변경\tO",                 ID_EDIT_TOGGLEMERGEMODE
        MENUITEM "병합 순서 앞으로 밀기\t,3",            ID_EDIT_MOVEUP
        MENUITEM "병합 순서 뒤로 밀기\t.",              ID_EDIT_MOVEDOWN
        MENUITEM "선택 항목의 비어있는 복사본 만들기\tC",      ID_EDIT_CREATEEMPTYCOPYFROMSELECTION
        MENUITEM SEPARATOR
        POPUP "병합된 글꼴의 세로 정렬"
        BEGIN
            MENUITEM "위",                                   ID_EDIT_VERTICALALIGNMENT_TOP
            MENUITEM "가운데",                                 ID_EDIT_VERTICALALIGNMENT_MIDDLE
            MENUITEM "기준선",                                 ID_EDIT_VERTICALALIGNMENT_BASELINE
            MENUITEM "아래",                                  ID_EDIT_VERTICALALIGNMENT_BOTTOM
            MENUITEM "로마자 기준선 (BASE 테이블)",                  ID_EDIT_VERTICALALIGNMENT_ROMANBASELINE
            MENUITEM "한자 중심 (BASE 테이블)",                    ID_EDIT_VERTICALALIGNMENT_IDEOGRAPHICCENTER
        END
    END
    POPUP "보기(&V)"
    BEGIN
        MENUITEM "다음 폰트(&N)\tCtrl+Tab",         ID_VIEW_NEXTFONT
        MENUITEM "이전 폰트(&P)\tCtrl+Shift+Tab",   ID_VIEW_PREVIOUSFONT
        MENUITEM SEPARATOR
        MENUITEM "미리보기에 자동 개행(word wrap) 포함(&W)\tP", ID_VIEW_WORDWRAP, CHECKED
        MENUITEM "미리보기에 자간 조정(kerning) 포함(&K)\tK", ID_VIEW_KERNING, CHECKED
        MENUITEM "줄 정보 표시(&L)\tL",              ID_VIEW_SHOWLINEMETRICS, CHECKED
        MENUITEM SEPARATOR
        MENUITEM "&100%\t1",                    ID_VIEW_100
        MENUITEM "&200%\t2",                    ID_VIEW_200
        MENUITEM "&300%\t3",                    ID_VIEW_300
        MENUITEM "&400%\t4",                    ID_VIEW_400
        MENUITEM "&500%\t5",                    ID_VIEW_500
        MENUITEM "&600%\t6",                    ID_VIEW_600
        MENUITEM "&700%\t7",                    ID_VIEW_700
        MENUITEM "&800%\t8",                    ID_VIEW_800
        MENUITEM "&900%\t9",                    ID_VIEW_900
    END
    POPUP "내보내기(&X)"
    BEGIN
        MENUITEM "미리 보기(&P)\tCtrl+P",           ID_EXPORT_PREVIEW
        MENUITEM SEPARATOR
        MENUITEM ".fdt 및 .tex 파일로 내보내기(&F)",    ID_EXPORT_RAW
        MENUITEM ".ttmp 텍스툴 모드팩 파일로 내보내기 (파일별 압축)(&W)", ID_EXPORT_TOTTMP_COMPRESSWHILEPACKING
        MENUITEM ".ttmp 텍스툴 모드팩 파일로 내보내기 (전체 압축)(&A)", ID_EXPORT_TOTTMP_COMPRESSAFTERPACKING
        MENUITEM ".ttmp 텍스툴 모드팩 파일로 내보내기 (압축하지 않음)(&N)", ID_EXPORT_TOTTMP_DONOTCOMPRESS
        MENUITEM SEPARATOR
        MENUITEM "선택한 요소의 글리프 내보내기(&G)...",     ID_EXPORT_GLYPHS
        MENUITEM "선택한 요소의 글리프를 조정 포함하여 내보내기(&J)...", ID_EXPORT_GLYPHSWITHADJUSTMENTS
        MENUITEM "현재 폰트의 글리프 내보내기(모든 구성 폰트)(&E)...", ID_EXPORT_FONTGLYPHS
        MENUITEM SEPARATOR
        MENUITEM "일반 용도 폰트를 로비에서도 사용하기 (font_lobby 접근 시 font 사용)(&M)", ID_EXPORT_MAPFONTLOBBY
        MENUITEM "일반 용도 폰트를 ChnAXIS{}에도 사용하기(&C)", ID_EXPORT_MAPFONTCHNAXIS
        MENUITEM "일반 용도 폰트를 KrnAXIS{}에도 사용하기(&K)", ID_EXPORT_MAPFONTKRNAXIS
        MENUITEM "일반 용도 폰트를 tcaxis{}에도 사용하기(&T)", ID_EXPORT_MAPFONTTCAXIS
    END
    POPUP "핫 리로드(&R)"
    BEGIN
        MENUITEM "실행 중인 모든 게임의 폰트 다시 불러오기(&R)", ID_HOTRELOAD_RELOAD
        MENUITEM "기본 폰트로 되돌리기(&D)", ID_HOTRELOAD_RESTORE
        MENUITEM SEPARATOR
        MENUITEM "자동(&A)", ID_HOTRELOAD_FONT_AUTO, CHECKED
        MENUITEM "font (&F)", ID_HOTRELOAD_FONT_FONT
        MENUITEM "font_lobby (&L)", ID_HOTRELOAD_FONT_LOBBY
        MENUITEM "chn_axis (&C)", ID_HOTRELOAD_FONT_CHNAXIS
        MENUITEM "krn_axis (&K)", ID_HOTRELOAD_FONT_KRNAXIS
        MENUITEM SEPARATOR
        MENUITEM "실험적인 기능이며, 실행 중인 게임이 강제 종료될 수 있습니다.", ID_HOTRELOAD_EXPERIMENTAL, INACTIVE
        MENUITEM "이 기능을 사용하려면 fdt/tex 파일을 Penumbra 모드 폴더로 내보내세요.", ID_HOTRELOAD_EXPORTFDT, INACTIVE
    END
END

IDR_CONTEXTMENU_FONTELEMENT MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "열기(&O)",                      ID_EDIT_DETAILS
        MENUITEM "오른쪽으로 밀린 글자 표시(&N)",          ID_CONTEXTMENU_SHOWNEGATIVEBEARING
        MENUITEM "글리프 내보내기(&G)...",               ID_EXPORT_GLYPHS
        MENUITEM "글리프를 조정 포함하여 내보내기(&J)...",     ID_EXPORT_GLYPHSWITHADJUSTMENTS
        MENUITEM SEPARATOR
        MENUITEM "자동 맞춤(&U)\tF",                ID_EDIT_AUTOFIT
        MENUITEM "모든 크기 자동 맞춤(&Z)\tShift+F",   ID_EDIT_AUTOFITALLSIZES
        MENUITEM SEPARATOR
        MENUITEM "잘라내기(&T)",                    ID_EDIT_CUT
        MENUITEM "복사(&C)",                      ID_EDIT_COPY
        MENUITEM "복제(&L)",                      ID_CONTEXTMENU_CLONE
        MENUITEM SEPARATOR
        MENUITEM "삭제(&D)",                      ID_EDIT_DELETE
    END
    POPUP ""
    BEGIN
        MENUITEM "추가(&A)\tIns",                 ID_EDIT_ADD
        MENUITEM "폰트로 요소 추가(&N)...\tShift+Ins",  ID_EDIT_ADDELEMENTFROMFONT
        MENUITEM "폰트에서 추가(&F)...",             ID_EDIT_ADDFROMFONT
        MENUITEM SEPARATOR
        MENUITEM "붙여넣기(&P)\tCtrl+V",            ID_EDIT_PASTE
    END
END


