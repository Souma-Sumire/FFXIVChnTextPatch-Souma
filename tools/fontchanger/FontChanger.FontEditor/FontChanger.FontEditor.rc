IDR_FONTEDITOR MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        POPUP "新建(&N)"
        BEGIN
            MENUITEM "游戏字体(&M)",                    ID_FILE_NEW_MAINGAMEFONT
            MENUITEM "登录界面字体(&L)",                  ID_FILE_NEW_LOBBYFONT
            MENUITEM "中文字体(&C)",                    ID_FILE_NEW_CHNAXIS
            MENUITEM "繁体中文字体(&T)",                  ID_FILE_NEW_TCAXIS
            MENUITEM "韩文字体(&K)",                    ID_FILE_NEW_KRNAXIS
        END
        MENUITEM "打开(&O)\tCtrl+O",              ID_FILE_OPEN
        MENUITEM "保存(&S)\tCtrl+S",              ID_FILE_SAVE
        MENUITEM "另存为(&A)\tCtrl+Shift+S",       ID_FILE_SAVEAS
        MENUITEM "保存副本(&C)",                    ID_FILE_SAVECOPYAS
        MENUITEM SEPARATOR
        POPUP "界面语言(&L)"
        BEGIN
            MENUITEM "自动检测(&A)",                    ID_FILE_LANGUAGE_AUTO
            MENUITEM SEPARATOR
            MENUITEM "英语(English)(&E)",             ID_FILE_LANGUAGE_ENGLISH
            MENUITEM "韩语(한국어)(&K)",                 ID_FILE_LANGUAGE_KOREAN
            MENUITEM "简体中文(&C)",                    ID_FILE_LANGUAGE_CHINESE
        END
        MENUITEM "Configure &Game Installations", ID_FILE_GAMEINSTALLATIONMANAGER
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)\tCtrl+Q",              ID_FILE_EXIT
    END
    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "添加字体(&A)\tIns",               ID_EDIT_ADD
        MENUITEM "从字体添加元素(&N)...\tShift+Ins",    ID_EDIT_ADDELEMENTFROMFONT
        MENUITEM "从字体添加(&F)...",                ID_EDIT_ADDFROMFONT
        MENUITEM "自动适配(&T)\tF",                  ID_EDIT_AUTOFIT
        MENUITEM "自动适配所有大小(&Z)\tShift+F",       ID_EDIT_AUTOFITALLSIZES
        MENUITEM "剪切(&T)\tCtrl+X",              ID_EDIT_CUT
        MENUITEM "复制(&C)\tCtrl+C",              ID_EDIT_COPY
        MENUITEM "粘贴(&P)\tCtrl+V",              ID_EDIT_PASTE
        MENUITEM "删除(&D)\tDel",                 ID_EDIT_DELETE
        MENUITEM "全选(&S)\tCtrl+A",              ID_EDIT_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "属性设置(&E)\tEnter",             ID_EDIT_DETAILS
        MENUITEM SEPARATOR
        MENUITEM "垂直偏移减小(向上)\tW",              ID_EDIT_DECREASEVERTICALOFFSET
        MENUITEM "垂直偏移增大(向下)\tS",              ID_EDIT_INCREASEVERTICALOFFSET
        MENUITEM "左移\tA",                       ID_EDIT_DECREASEHORIZONTALOFFSET
        MENUITEM "右移\tD",                       ID_EDIT_INCREASEHORIZONTALOFFSET
        MENUITEM "缩小字间距\tQ",                    ID_EDIT_DECREASELETTERSPACING
        MENUITEM "增大字间距\tE",                    ID_EDIT_INCREASELETTERSPACING
        MENUITEM "缩小字体 1px\t[",                 ID_EDIT_DECREASEFONTSIZEBY1
        MENUITEM "放大字体 1px\t]",                 ID_EDIT_INCREASEFONTSIZEBY1
        MENUITEM "缩小字体 0.2px\tShift+[",         ID_EDIT_DECREASEFONTSIZEBY0_2
        MENUITEM "放大字体 0.2px\tShift+]",         ID_EDIT_INCREASEFONTSIZEBY0_2
        MENUITEM "切换合并模式\tO",                   ID_EDIT_TOGGLEMERGEMODE
        MENUITEM "上移\t,",                       ID_EDIT_MOVEUP
        MENUITEM "下移\t.",                       ID_EDIT_MOVEDOWN
        MENUITEM "创建空白副本\tC",                   ID_EDIT_CREATEEMPTYCOPYFROMSELECTION
        MENUITEM SEPARATOR
        POPUP "合并字体的垂直对齐"
        BEGIN
            MENUITEM "顶部",                                  ID_EDIT_VERTICALALIGNMENT_TOP
            MENUITEM "居中",                                  ID_EDIT_VERTICALALIGNMENT_MIDDLE
            MENUITEM "基线",                                  ID_EDIT_VERTICALALIGNMENT_BASELINE
            MENUITEM "底部",                                  ID_EDIT_VERTICALALIGNMENT_BOTTOM
            MENUITEM "罗马基线 (BASE 表)",                       ID_EDIT_VERTICALALIGNMENT_ROMANBASELINE
            MENUITEM "表意字框中心 (BASE 表)",                      ID_EDIT_VERTICALALIGNMENT_IDEOGRAPHICCENTER
        END
    END
    POPUP "查看(&V)"
    BEGIN
        MENUITEM "下一个字体(&N)\tCtrl+Tab",         ID_VIEW_NEXTFONT
        MENUITEM "上一个字体(&P)\tCtrl+Shift+Tab",   ID_VIEW_PREVIOUSFONT
        MENUITEM SEPARATOR
        MENUITEM "自动换行(&W)\tP",                 ID_VIEW_WORDWRAP, CHECKED
        MENUITEM "字距调整(&K)\tK",                 ID_VIEW_KERNING, CHECKED
        MENUITEM "显示行高信息(&L)\tL",               ID_VIEW_SHOWLINEMETRICS, CHECKED
        MENUITEM SEPARATOR
        MENUITEM "&100%\t1",                    ID_VIEW_100
        MENUITEM "&200%\t2",                    ID_VIEW_200
        MENUITEM "&300%\t3",                    ID_VIEW_300
        MENUITEM "&400%\t4",                    ID_VIEW_400
        MENUITEM "&500%\t5",                    ID_VIEW_500
        MENUITEM "&600%\t6",                    ID_VIEW_600
        MENUITEM "&700%\t7",                    ID_VIEW_700
        MENUITEM "&800%\t8",                    ID_VIEW_800
        MENUITEM "&900%\t9",                    ID_VIEW_900
    END
    POPUP "导出(&X)"
    BEGIN
        MENUITEM "预览效果(&P)\tCtrl+P",            ID_EXPORT_PREVIEW
        MENUITEM SEPARATOR
        MENUITEM "导出原始文件(&F)",                  ID_EXPORT_RAW
        MENUITEM "导出模组 - 边打包边压缩(&W)",           ID_EXPORT_TOTTMP_COMPRESSWHILEPACKING
        MENUITEM "导出模组 - 打包后压缩(&A)",            ID_EXPORT_TOTTMP_COMPRESSAFTERPACKING
        MENUITEM "导出模组 - 不压缩(&N)",              ID_EXPORT_TOTTMP_DONOTCOMPRESS
        MENUITEM SEPARATOR
        MENUITEM "导出所选元素的字形(&G)...",          ID_EXPORT_GLYPHS
        MENUITEM "导出所选元素的字形（含调整）(&J)...",    ID_EXPORT_GLYPHSWITHADJUSTMENTS
        MENUITEM "导出当前字体的字形(全部元素)(&E)...",  ID_EXPORT_FONTGLYPHS
        MENUITEM SEPARATOR
        MENUITEM "同时替换登录界面字体(&M)",              ID_EXPORT_MAPFONTLOBBY
        MENUITEM "同时替换中文字体(&C)",                ID_EXPORT_MAPFONTCHNAXIS
        MENUITEM "同时替换韩文字体(&K)",                ID_EXPORT_MAPFONTKRNAXIS
        MENUITEM "同时替换繁体中文字体(&T)",              ID_EXPORT_MAPFONTTCAXIS
    END
    POPUP "热重载(&R)"
    BEGIN
        MENUITEM "重新加载所有运行中游戏的字体(&R)", ID_HOTRELOAD_RELOAD
        MENUITEM "恢复默认字体(&D)", ID_HOTRELOAD_RESTORE
        MENUITEM SEPARATOR
        MENUITEM "自动(&A)", ID_HOTRELOAD_FONT_AUTO, CHECKED
        MENUITEM "font (&F)", ID_HOTRELOAD_FONT_FONT
        MENUITEM "font_lobby (&L)", ID_HOTRELOAD_FONT_LOBBY
        MENUITEM "chn_axis (&C)", ID_HOTRELOAD_FONT_CHNAXIS
        MENUITEM "krn_axis (&K)", ID_HOTRELOAD_FONT_KRNAXIS
        MENUITEM SEPARATOR
        MENUITEM "实验性功能，运行中的游戏仍可能崩溃。", ID_HOTRELOAD_EXPERIMENTAL, INACTIVE
        MENUITEM "需将原始文件 (fdt/tex) 导出到 Penumbra 模组目录才能使用此功能。", ID_HOTRELOAD_EXPORTFDT, INACTIVE
    END
END

IDR_CONTEXTMENU_FONTELEMENT MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "打开(&O)",                      ID_EDIT_DETAILS
        MENUITEM "显示左侧边距为负的码点(&N)...",       ID_CONTEXTMENU_SHOWNEGATIVEBEARING
        MENUITEM "导出字形(&G)...",                  ID_EXPORT_GLYPHS
        MENUITEM "导出字形（含调整）(&J)...",            ID_EXPORT_GLYPHSWITHADJUSTMENTS
        MENUITEM SEPARATOR
        MENUITEM "自动适配(&U)\tF",                  ID_EDIT_AUTOFIT
        MENUITEM "自动适配所有大小(&Z)\tShift+F",       ID_EDIT_AUTOFITALLSIZES
        MENUITEM SEPARATOR
        MENUITEM "剪切(&T)",                      ID_EDIT_CUT
        MENUITEM "复制(&C)",                      ID_EDIT_COPY
        MENUITEM "克隆(&L)",                      ID_CONTEXTMENU_CLONE
        MENUITEM SEPARATOR
        MENUITEM "删除(&D)",                      ID_EDIT_DELETE
    END
    POPUP ""
    BEGIN
        MENUITEM "添加字体(&A)\tIns",               ID_EDIT_ADD
        MENUITEM "从字体添加元素(&N)...\tShift+Ins",    ID_EDIT_ADDELEMENTFROMFONT
        MENUITEM "从字体添加(&F)...",                ID_EDIT_ADDFROMFONT
        MENUITEM SEPARATOR
        MENUITEM "粘贴(&P)\tCtrl+V",               ID_EDIT_PASTE
    END
END


