LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_FONTEDITOR MENU
BEGIN
    POPUP "&File"
    BEGIN
        POPUP "&New"
        BEGIN
            MENUITEM "&Main Game Font (font)",      ID_FILE_NEW_MAINGAMEFONT
            MENUITEM "&Lobby Font (font_lobby)",    ID_FILE_NEW_LOBBYFONT
            MENUITEM "&Korean (KrnAXIS)",           ID_FILE_NEW_KRNAXIS
            MENUITEM "&Chinese (Simplified) (ChnAXIS)", ID_FILE_NEW_CHNAXIS
            MENUITEM "Chinese (&Traditional) (tcaxis)", ID_FILE_NEW_TCAXIS
        END
        MENUITEM "&Open\tCtrl+O",               ID_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As\tCtrl+Shift+S",      ID_FILE_SAVEAS
        MENUITEM "Save &Copy As",               ID_FILE_SAVECOPYAS
        MENUITEM SEPARATOR
        POPUP "&Language"
        BEGIN
            MENUITEM "&Auto",                       ID_FILE_LANGUAGE_AUTO
            MENUITEM SEPARATOR
            MENUITEM "&English",                    ID_FILE_LANGUAGE_ENGLISH
            MENUITEM "&Korean (한국어)",               ID_FILE_LANGUAGE_KOREAN
            MENUITEM "&Chinese (简体中文)",             ID_FILE_LANGUAGE_CHINESE
        END
        MENUITEM "Configure &Game Installations", ID_FILE_GAMEINSTALLATIONMANAGER
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tCtrl+Q",               ID_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Add\tIns",                   ID_EDIT_ADD
        MENUITEM "Add Element from Fo&nt...\tShift+Ins", ID_EDIT_ADDELEMENTFROMFONT
        MENUITEM "Add from &Font...",           ID_EDIT_ADDFROMFONT
        MENUITEM "Auto-fi&t\tF",                ID_EDIT_AUTOFIT
        MENUITEM "Auto-fit All Si&zes\tShift+F", ID_EDIT_AUTOFITALLSIZES
        MENUITEM "&Cut\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
        MENUITEM "&Delete\tDel",                ID_EDIT_DELETE
        MENUITEM "&Select All\tCtrl+A",         ID_EDIT_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "D&etails\tEnter",             ID_EDIT_DETAILS
        MENUITEM SEPARATOR
        MENUITEM "Decrease Vertical Offset (Upwards)\tW", ID_EDIT_DECREASEVERTICALOFFSET
        MENUITEM "Increase Vertical Offset (Downwards)\tS", ID_EDIT_INCREASEVERTICALOFFSET
        MENUITEM "Decrease Horizontal Offset(Leftwards)\tA", ID_EDIT_DECREASEHORIZONTALOFFSET
        MENUITEM "Increase Horizontal Offset(Rightwards)\tD", ID_EDIT_INCREASEHORIZONTALOFFSET
        MENUITEM "Decrease Letter Spacing\tQ",  ID_EDIT_DECREASELETTERSPACING
        MENUITEM "Increase Letter Spacing\tE",  ID_EDIT_INCREASELETTERSPACING
        MENUITEM "Decrease Font Size by 1px\t[", ID_EDIT_DECREASEFONTSIZEBY1
        MENUITEM "Increase Font Size by 1px\t]", ID_EDIT_INCREASEFONTSIZEBY1
        MENUITEM "Decrease Font Size by 0.2px\tShift+[", ID_EDIT_DECREASEFONTSIZEBY0_2
        MENUITEM "Increase Font Size by 0.2px\tShift+]", ID_EDIT_INCREASEFONTSIZEBY0_2
        MENUITEM "Toggle Merge Mode\tO",        ID_EDIT_TOGGLEMERGEMODE
        MENUITEM "Move Up\t,",                  ID_EDIT_MOVEUP
        MENUITEM "Move Down\t.",                ID_EDIT_MOVEDOWN
        MENUITEM "Create Empty Copy From Selection\tC", ID_EDIT_CREATEEMPTYCOPYFROMSELECTION
        MENUITEM SEPARATOR
        POPUP "Vertical Alignment of Merged Fonts"
        BEGIN
            MENUITEM "&Top",                                ID_EDIT_VERTICALALIGNMENT_TOP
            MENUITEM "&Middle",                             ID_EDIT_VERTICALALIGNMENT_MIDDLE
            MENUITEM "&Baseline",                           ID_EDIT_VERTICALALIGNMENT_BASELINE
            MENUITEM "B&ottom",                             ID_EDIT_VERTICALALIGNMENT_BOTTOM
            MENUITEM "&Roman Baseline (BASE table)",        ID_EDIT_VERTICALALIGNMENT_ROMANBASELINE
            MENUITEM "&Ideographic Center (BASE table)",    ID_EDIT_VERTICALALIGNMENT_IDEOGRAPHICCENTER
        END
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Next Font\tCtrl+Tab",        ID_VIEW_NEXTFONT
        MENUITEM "&Previous Font\tCtrl+Shift+Tab", ID_VIEW_PREVIOUSFONT
        MENUITEM SEPARATOR
        MENUITEM "Preview with &Word Wrap\tP",  ID_VIEW_WORDWRAP, CHECKED
        MENUITEM "Preview with &Kerning\tK",    ID_VIEW_KERNING, CHECKED
        MENUITEM "Show &Line Metrics\tL",       ID_VIEW_SHOWLINEMETRICS, CHECKED
        MENUITEM SEPARATOR
        MENUITEM "&100%\t1",                    ID_VIEW_100
        MENUITEM "&200%\t2",                    ID_VIEW_200
        MENUITEM "&300%\t3",                    ID_VIEW_300
        MENUITEM "&400%\t4",                    ID_VIEW_400
        MENUITEM "&500%\t5",                    ID_VIEW_500
        MENUITEM "&600%\t6",                    ID_VIEW_600
        MENUITEM "&700%\t7",                    ID_VIEW_700
        MENUITEM "&800%\t8",                    ID_VIEW_800
        MENUITEM "&900%\t9",                    ID_VIEW_900
    END
    POPUP "E&xport"
    BEGIN
        MENUITEM "&Preview\tCtrl+P",            ID_EXPORT_PREVIEW
        MENUITEM SEPARATOR
        MENUITEM "Export to .&fdt and .tex files", ID_EXPORT_RAW
        MENUITEM "Export to .ttmp TexTools ModPack file (Compress &while packing)", ID_EXPORT_TOTTMP_COMPRESSWHILEPACKING
        MENUITEM "Export to .ttmp TexTools ModPack file (Compress &after packing)", ID_EXPORT_TOTTMP_COMPRESSAFTERPACKING
        MENUITEM "Export to .ttmp TexTools ModPack file (Do &not compress)", ID_EXPORT_TOTTMP_DONOTCOMPRESS
        MENUITEM SEPARATOR
        MENUITEM "Export &Glyphs of Selected Elements...", ID_EXPORT_GLYPHS
        MENUITEM "Export Glyphs of Selected Elements with Ad&justments...", ID_EXPORT_GLYPHSWITHADJUSTMENTS
        MENUITEM "Export Glyphs of Curr&ent Font (All Elements)...", ID_EXPORT_FONTGLYPHS
        MENUITEM SEPARATOR
        MENUITEM "Additionally &map font_lobby{} to font{}", ID_EXPORT_MAPFONTLOBBY
        MENUITEM "Additionally map &ChnAXIS{} to font{}(AXIS)", ID_EXPORT_MAPFONTCHNAXIS
        MENUITEM "Additionally map &KrnAXIS{} to font{}(AXIS)", ID_EXPORT_MAPFONTKRNAXIS
        MENUITEM "Additionally map &tcaxis{} to font{}(AXIS)", ID_EXPORT_MAPFONTTCAXIS
    END
    POPUP "Hot &Reload"
    BEGIN
        MENUITEM "&Reload fonts in all running instances of games", ID_HOTRELOAD_RELOAD
        MENUITEM "Restore to &default", ID_HOTRELOAD_RESTORE
        MENUITEM SEPARATOR
        MENUITEM "&Auto", ID_HOTRELOAD_FONT_AUTO, CHECKED
        MENUITEM "font (&F)", ID_HOTRELOAD_FONT_FONT
        MENUITEM "font_lobby (&L)", ID_HOTRELOAD_FONT_LOBBY
        MENUITEM "chn_axis (&C)", ID_HOTRELOAD_FONT_CHNAXIS
        MENUITEM "krn_axis (&K)", ID_HOTRELOAD_FONT_KRNAXIS
        MENUITEM SEPARATOR
        MENUITEM "Experimental; the running game may still crash.", ID_HOTRELOAD_EXPERIMENTAL, INACTIVE
        MENUITEM "Export fdt/tex combo to Penumbra mod directory to use this feature.", ID_HOTRELOAD_EXPORTFDT, INACTIVE
    END
END

IDR_CONTEXTMENU_FONTELEMENT MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Open",                       ID_EDIT_DETAILS
        MENUITEM "Show &Negative-Bearing Codepoints...", ID_CONTEXTMENU_SHOWNEGATIVEBEARING
        MENUITEM "Export &Glyphs...",           ID_EXPORT_GLYPHS
        MENUITEM "Export Glyphs with Ad&justments...", ID_EXPORT_GLYPHSWITHADJUSTMENTS
        MENUITEM SEPARATOR
        MENUITEM "A&uto-fit\tF",                ID_EDIT_AUTOFIT
        MENUITEM "Auto-fit All Si&zes\tShift+F", ID_EDIT_AUTOFITALLSIZES
        MENUITEM SEPARATOR
        MENUITEM "Cu&t",                        ID_EDIT_CUT
        MENUITEM "&Copy",                       ID_EDIT_COPY
        MENUITEM "C&lone",                      ID_CONTEXTMENU_CLONE
        MENUITEM SEPARATOR
        MENUITEM "&Delete",                     ID_EDIT_DELETE
    END
    POPUP ""
    BEGIN
        MENUITEM "&Add\tIns",                   ID_EDIT_ADD
        MENUITEM "Add Element from Fo&nt...\tShift+Ins", ID_EDIT_ADDELEMENTFROMFONT
        MENUITEM "Add from &Font...",           ID_EDIT_ADDFROMFONT
        MENUITEM SEPARATOR
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
    END
END


